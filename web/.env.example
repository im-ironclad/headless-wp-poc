# Copy to .env.local. ./wordpress/setup.sh prints real values.

# WordPress origin. Server-side fetches use plain http to avoid trusting ddev's local HTTPS certificate.
WORDPRESS_URL=http://headless-wp.ddev.site

# Draft Preview: an Application Password for the `headless-preview` editor user.
WORDPRESS_PREVIEW_USER=headless-preview
WORDPRESS_PREVIEW_APP_PASSWORD=

# Shared secrets. Must match .ddev/config.headless.yaml in /wordpress.
REVALIDATE_SECRET=dev-revalidate-secret
PREVIEW_SECRET=dev-preview-secret
